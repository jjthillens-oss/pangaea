[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

; M_CreatureBoulderA: the creature field's merged copies of creature_boulder_a (field rev 2b scatter, tools/blender/creature_flora.py
; build_field_scatter) draw with the kit asset's own baked textures, which Godot extracted from
; assets/export/creature_boulder_a.glb, as that GLB's material does (its base colour factor as the albedo colour; roughness in
; the ORM's green; metallic is 0 throughout, the ORM's blue). The field's stand-in M_CreatureBoulderA is mapped here in its
; .glb.import. Written by tools/blender/make_creature_world.py --import.

[ext_resource type="Texture2D" path="res://assets/export/creature_boulder_a_T_CreatureBoulderA_Albedo.png" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/export/creature_boulder_a_T_CreatureBoulderA_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/export/creature_boulder_a_T_CreatureBoulderA_Normal.png" id="3_normal"]

[resource]
resource_name = "M_CreatureBoulderA"
albedo_color = Color(1.0, 1.0, 1.0, 1)
albedo_texture = ExtResource("1_albedo")
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_normal")
