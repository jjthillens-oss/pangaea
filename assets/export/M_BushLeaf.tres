[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

; The fruit bush's leaf core under its leaf cards (assets/records/creature_fruit_bush.json): the GLB's baked greyscale detail times the flat colour #245442, times the
; MultiMesh instance colour (vertex_color_use_as_albedo; instance colours are read as sRGB like albedo_color, and
; a white instance draws the asset as baked), with the baked ORM's roughness and normal map.
; creature_fruit_bush.glb.import points the imported M_BushLeaf here. Written by tools/blender/make_creature_world.py --import.

[ext_resource type="Texture2D" path="res://assets/export/creature_fruit_bush_T_CreatureFruitBush_Albedo.png" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/export/creature_fruit_bush_T_CreatureFruitBush_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/export/creature_fruit_bush_T_CreatureFruitBush_Normal.png" id="3_normal"]

[resource]
resource_name = "M_BushLeaf"
vertex_color_use_as_albedo = true
vertex_color_is_srgb = true
albedo_color = Color(0.141, 0.329, 0.259, 1)
albedo_texture = ExtResource("1_albedo")
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_normal")
metallic_specular = 0.2
