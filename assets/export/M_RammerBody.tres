[gd_resource type="StandardMaterial3D" load_steps=4 format=3]

; The territorial rammer body's material (assets/records/creature_rammer_body.json). Its colour is the mesh's vertex
; colours, which the glTF importer would leave unused: pale sand with three dark
; bands and a cream belly, stored sRGB-encoded so both
; renderers shade them like an albedo colour. creature_rammer_body.glb.import points the imported material here.
; Production detail (M1 production art, docs/art/production_m1.md): the albedo texture is a
; greyscale hide detail (with baked occlusion) that multiplies the vertex colours, the ORM gives
; roughness (green), and the normal map carries the finer body's smooth shading and the hide's
; relief. All three are the GLB's own baked textures, extracted on import.

[ext_resource type="Texture2D" path="res://assets/export/creature_rammer_body_T_Rammer_Albedo.png" id="1_albedo"]
[ext_resource type="Texture2D" path="res://assets/export/creature_rammer_body_T_Rammer_ORM.png" id="2_orm"]
[ext_resource type="Texture2D" path="res://assets/export/creature_rammer_body_T_Rammer_Normal.png" id="3_normal"]

[resource]
resource_name = "M_RammerBody"
vertex_color_use_as_albedo = true
vertex_color_is_srgb = true
albedo_texture = ExtResource("1_albedo")
roughness_texture = ExtResource("2_orm")
roughness_texture_channel = 1
normal_enabled = true
normal_texture = ExtResource("3_normal")
