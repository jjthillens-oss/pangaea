[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; The pool floor's material (assets/records/pool_floor.json). Its colour is the mesh's vertex
; colours, which the glTF importer would leave unused: sand, silt patches and the rim stone,
; stored sRGB-encoded so both renderers shade them like an albedo colour. Roughness matches the
; Blender material M_PoolFloor. pool_floor.glb.import points the imported material here.
; Two passes follow: moving caustic light (M_PoolCaustics.tres), then the water over the floor
; (M_PoolWater.tres), which takes red first with depth.
; Production detail (M1 production art, assets/records/pool_floor.json): a tangent-space normal
; map of sand ripples from the CC0 Poly Haven scan Aerial Beach 01, tiled every 5 m (132 m / 26.4).
; It changes only shading, never the vertex colours, so the caustics catch on the ripples.

[ext_resource type="Material" path="res://assets/export/M_PoolCaustics.tres" id="1_caustics"]
[ext_resource type="Texture2D" path="res://assets/export/T_PoolFloor_Normal.png" id="2_normal"]

[resource]
resource_name = "M_PoolFloor"
next_pass = ExtResource("1_caustics")
vertex_color_use_as_albedo = true
vertex_color_is_srgb = true
roughness = 0.9
normal_enabled = true
normal_scale = 0.8
normal_texture = ExtResource("2_normal")
uv1_scale = Vector3(26.4, 26.4, 1)
